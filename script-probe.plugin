#!name = 脚本探针（诊断用，测完删）
#!desc = 三层探针：百度（验证脚本引擎）→ 苹果CDN（验证该域名拦截）→ webvtt（验证字幕匹配）。各自弹通知。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs

[Script]
request if ${url} ~= /^https?:\/\/www\.baidu\.com\//i then script("https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js") with tag="探针A-百度", timeout=10

request if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.(m3u8|m4s|webvtt)/i then script("https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js") with tag="探针B-苹果CDN", timeout=10

request if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.webvtt/i then script("https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js") with tag="探针C-webvtt", timeout=10

[MITM]
hostname = www.baidu.com, hls.itunes.apple.com, hls-svod.itunes.apple.com

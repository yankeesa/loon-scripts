#!name = 脚本探针（诊断用，测完删）
#!desc = 三层探针：百度（验证脚本引擎）→ 苹果CDN（验证该域名拦截）→ webvtt（验证字幕匹配）。各自弹通知。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs

[Script]
http-request ^https?:\/\/www\.baidu\.com\/ script-path=https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js, requires-body=false, timeout=10, tag=探针A-百度, enabled=true
http-request ^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.(m3u8|m4s|webvtt) script-path=https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js, requires-body=false, timeout=10, tag=探针B-苹果CDN, enabled=true
http-request ^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.webvtt script-path=https://cdn.jsdelivr.net/gh/yankeesa/loon-scripts@master/dsl-ping.js, requires-body=false, timeout=10, tag=探针C-webvtt, enabled=true

[MITM]
hostname = www.baidu.com, hls.itunes.apple.com, hls-svod.itunes.apple.com

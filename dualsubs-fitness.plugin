#!name = Fitness+ 中文字幕（智谱直连机翻）
#!desc = 拦截 Fitness+ 的 WebVTT 字幕文件，直连智谱 GLM 分块并行翻译成简体中文并替换显示（选「英语听障人士字幕」即出中文），带分段缓存，二次播放秒同步。官方中文轨自动放行。Loon 3.5.1+ 新语法。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs
#!author = yankeesa

[Script]

# 1. 拦截 m3u8：master 加「简体中文」轨（备用，Fitness+ 的 master 通常不经过 Loon）
response if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.m3u8/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-m3u8.js?v=17") with tag="Fitness中文字幕轨", timeout=30, requires_body=true

# 2. 拦截英文字幕 webvtt：替换为纯中文（dsl_vtt_mode=both 可切双语）
response if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.webvtt/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-vtt.js?v=17") with tag="Fitness中文字幕翻译", timeout=120, requires_body=true

[MITM]
hostname = hls.itunes.apple.com, hls-svod.itunes.apple.com

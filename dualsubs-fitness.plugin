#!name = DualSubs · Fitness+ 字幕直译
#!desc = 拦截 Fitness+ 新版 WebVTT 字幕（Apple 已去掉 subtype 参数导致 DualSubs 正则失效），直接交给 LLM 网关翻译并注入双语字幕。Loon 3.5.1+ 新语法。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs
#!author = yankeesa

[Script]

# 主功能：翻译字幕并注入中文
response if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.webvtt/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-vtt.js?v=8") with tag="Fitness字幕直译", timeout=120, requires_body=true

[MITM]
hostname = hls.itunes.apple.com, hls-svod.itunes.apple.com

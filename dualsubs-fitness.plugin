#!name = Apple 字幕简体中文轨
#!desc = 在 Apple TV / Fitness+ 播放器右下角字幕菜单里增加「简体中文」选项（原理同 DualSubs 字幕轨），翻译由智谱 GLM 直连完成。Loon 3.5.1+ 新语法。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs
#!author = yankeesa

[Script]

# 1. 拦截 m3u8：master 加「简体中文」轨，简体中文轨 playlist 给分段加标记
response if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.m3u8/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-m3u8.js?v=9") with tag="Fitness中文字幕轨", timeout=30, requires_body=true

# 2. 拦截英文字幕 webvtt：替换为纯中文（dsl_vtt_mode=both 可切双语）
response if ${url} ~= /^https?:\/\/hls(-svod)?\.itunes\.apple\.com\/.*\.webvtt/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-vtt.js?v=11") with tag="Fitness中文字幕翻译", timeout=120, requires_body=true

[MITM]
hostname = hls.itunes.apple.com, hls-svod.itunes.apple.com

#!name=中国电信营业厅签到
#!desc=每日金豆签到（chavyleung 10000 脚本，yankeesa 维护）
#!author=chavyleung / yankeesa
#!icon=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dianxin.png

[Script]
# 获取签到所需的签名头/体：打开中国电信 APP → 我 → 签到，触发一次抓取
http-request ^https://wapside\.189\.cn:9001/jt-sign/api/home/homeInfo script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.cookie.js, requires-body=true, tag=电信签到-获取凭证, enabled=true

# 每日自动签到（金豆可兑话费/流量/实物）
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.js, tag=电信营业厅签到, enabled=true

[MITM]
hostname = wapside.189.cn

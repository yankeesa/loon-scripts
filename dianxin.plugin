#!name=中国电信营业厅签到
#!desc=每日金豆签到 v2（接口已迁移 wappark.189.cn，yankeesa 维护）
#!author=chavyleung / yankeesa
#!icon=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dianxin.png

[Script]
# 获取签到凭证: 打开中国电信 APP → 签到页面, 抓取 wappark.189.cn 会话 Cookie
http-request ^https://wappark\.189\.cn script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.cookie.js, tag=电信签到-获取凭证, enabled=true

# 每日自动签到（金豆可兑话费/流量/实物）
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.js, tag=电信营业厅签到, enabled=true

[MITM]
hostname = wappark.189.cn

#!name=中国电信营业厅签到
#!desc=每日金豆签到（Loon 原生修复版，yankeesa 维护）
#!author=chavyleung / yankeesa
#!icon=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dianxin.png

[Script]
# 获取签到所需的手机号/签名体：打开中国电信 APP → 我 → 签到，触发一次抓取
http-request ^https://wapside\.189\.cn script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.cookie.js, tag=电信签到-获取凭证, enabled=true

# 每日自动签到（金豆可兑话费/流量/实物）
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/10000.js, tag=电信营业厅签到, enabled=true

[MITM]
hostname = wapside.189.cn, api.189.cn, wap.189.cn

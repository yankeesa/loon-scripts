#!name = DualSubs · GLM 翻译后端
#!desc = 把 DualSubs 发往 Google 翻译的请求在本地接管，直连智谱 GLM 翻译并按 Google 格式返回。字幕轨注入仍由 DualSubs 完成（电视端需配 iRingo: TV app）。Loon 3.5.1+ 新语法。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = DualSubs
#!author = yankeesa

[Script]

request if ${url} ~= /^https?:\/\/translate\.googleapis\.com\/translate_a\/single/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-llm.js?v=18") with tag="GLM翻译-googleapis", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/translate\.google\.com\/translate_a\/single/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-llm.js?v=18") with tag="GLM翻译-google", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/clients5\.google\.com\/translate_a\/t/i then script("https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-llm.js?v=18") with tag="GLM翻译-clients5", timeout=60, requires_body=true

[MITM]
hostname = translate.googleapis.com, translate.google.com, clients5.google.com

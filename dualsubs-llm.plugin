#!name = DualSubs · LLM 中文字幕
#!desc = 把 DualSubs 的 Google 翻译请求转发到局域网 LLM 网关（术语表 + 上下文 + 缓存）。需同时启用 DualSubs: 🔣 Universal。
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon_dualsubs.png
#!category = 🍿️ DualSubs
#!author = yankeesa

[Script]
http-request ^https?://translate\.googleapis\.com/translate_a/single script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-llm.js, requires-body=false, tag=字幕LLM转发-googleapis
http-request ^https?://translate\.google\.com/translate_a/single script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/dsl-llm.js, requires-body=false, tag=字幕LLM转发-google

[MITM]
hostname = translate.googleapis.com, translate.google.com

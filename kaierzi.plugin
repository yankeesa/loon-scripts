#!name = 凯尔资商城每日任务
#!desc = 凯尔资商城小程序：每日登录 + 20赞 + 10评论（v11 完成判定改用服务端 agreed 实测，纠正并发抵消后的本地虚高进度）
#!author = Custom
#!icon = https://raw.githubusercontent.com/yankeesa/loon-scripts/master/icon.png

[Script]
# 抓取 unionId（打开小程序时自动捕获）
http-request ^https?:\/\/api.carez.com.cn.* script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/kaierzi-capture.js, requires-body=false, timeout=10, tag=凯尔资_获取unionId, enabled=true

# 每日任务：主跑 10:05 + 补跑 14:05（共 2 个点，保持低频次）
# v8 要点（保留）：
#  - 点赞池只收 agreed=0 的未赞帖（接口是 toggle，重复点=取消赞），未赞帖随当天新帖增长；
#    10:05 新帖少常点不满，因此把补跑挪到 14:05（新帖攒够后一次补齐缺额）。
#  - 「完成」只认真实进度(赞>=20 且 评>=10)，不再有「跑过一轮就当完成」的标记；
#    没点满的每个定时点都会继续补，已完成的点静默跳过、不重跑、不弹通知。
#  - 补跑时重新拉列表，早上点过的帖 agreed=1 会自动排除，不会取消旧赞；评论已满则不再发。
# v9/v10 多设备并发保护：
#  - iPad / iPhone 共用同一套配置且强制同步时，两台同时跑会对同一批新帖各点一次赞，
#    因 toggle 语义互相抵消 → 每日点赞 0 分。脚本开头的「设备角色守门」会读本地
#    $persistentStore（每台设备独立、不随配置同步），被标记为 idle 的设备静默退出。
#  - 角色由下面两条【手动脚本】设定，幂等、点错也不会误翻：
#      副设备 → 运行「凯尔资_设为副设备_手动运行」一次
#      主设备 → 什么都不用点（或运行「凯尔资_设为主设备_手动运行」明确标记）
# v11 新增：
#  - 完成判定改用服务端 agreed 实测的「今日已赞帖数」，覆盖本地虚高进度；
#    并发抵消 / 赞被取消后不再误判完成，每个定时点都会继续补到真满 20 赞。
#  - 点赞池限定为「今日新帖且 agreed=0」，与校准口径一致；检测到赞被取消会弹提示。
cron "5 10 * * *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/kaierzi-checkin.js?v=11, timeout=900, tag=凯尔资_每日任务, enabled=true
cron "5 14 * * *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/kaierzi-checkin.js?v=11, timeout=900, tag=凯尔资_补全点赞, enabled=true

# 设备角色（两条 cron 都是永不触发的日期，仅为了让脚本出现在 Loon 脚本列表里供手动运行）
cron "0 0 30 2 *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/kaierzi-role.js, timeout=30, tag=凯尔资_设为副设备_手动运行, enabled=true
cron "0 0 31 2 *" script-path=https://raw.githubusercontent.com/yankeesa/loon-scripts/master/kaierzi-role-primary.js, timeout=30, tag=凯尔资_设为主设备_手动运行, enabled=true

[MITM]
hostname = api.carez.com.cn
